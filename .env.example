# Girls Girl WTTB — API configuration
# Copy to .env.local and fill in your values.
# Never commit .env.local (already in .gitignore).

# ── Public (browser-safe) ─────────────────────────────────────────────────────
NEXT_PUBLIC_GATEWAY_URL=https://api.girlsgirlwttb.com
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://backend.girlsgirlwttb.com/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# Set to "mock" to keep using src/services/* seed data (default for prototype)
NEXT_PUBLIC_API_MODE=mock

# ── Server-only (API routes / SSR — no NEXT_PUBLIC prefix) ────────────────────
# GATEWAY_SERVICE_TOKEN=
# APPWRITE_API_KEY=
# STRIPE_SECRET_KEY=
